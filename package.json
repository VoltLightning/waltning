{
  "name": "waltning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @waltning/api dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "verify": "pnpm check && pnpm -r typecheck && pnpm test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U waltning -d waltning",
    "db:migrate": "pnpm --filter @waltning/db migrate",
    "db:generate": "pnpm --filter @waltning/db generate",
    "db:studio": "pnpm --filter @waltning/db studio",
    "mm:extract": "pnpm --filter @waltning/migrate-mm extract",
    "mm:import": "pnpm --filter @waltning/migrate-mm import",
    "mm:verify": "pnpm --filter @waltning/migrate-mm verify",
    "mm:all": "pnpm mm:extract && pnpm mm:import && pnpm mm:verify",
    "typecheck": "pnpm -r typecheck",
    "db:seed": "pnpm --filter @waltning/db seed",
    "db:fx": "pnpm --filter @waltning/db fx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
