# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo
storybook-static/

# Playwright's own output. The *baselines* under `visual/__screenshots__` are
# committed — they are the expected values, and a visual test with no reference
# in the repository compares against whatever the last run happened to produce.
test-results/
playwright-report/
blob-report/

# `pnpm e2e`'s own API and web bundle, spawned by `tools/e2e/setup/global.ts`
# — read only when a process never comes up, never a spec's own output.
tools/e2e/.logs/

# Scratch space for skills that draft in the working tree. Not source, and its
# drafts are throwaway HTML that Biome would lint as if it were shipped.
.superpowers/

# Expo / React Native
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
ios/Pods/
android/.gradle/
android/app/build/

# Secrets and local config
.env
.env.*
# Any *.env, not only the exact name: secrets.env and config/prod.env
# were caught by neither .gitignore nor the hook.
*.env
!.env.example

# The pre-commit sweep's term list. It holds the real names and institutions
# that the public specification replaced with placeholders — so the list is
# itself the private data, and committing it would undo the abstraction it
# exists to protect. The vault note "Real to abstract mapping" is the source.
.githooks/private-terms.txt

# Certificates and identities. Caddy writes the Tailscale-issued cert to disk,
# and the age identity is the one key whose loss makes every B2 backup
# unreadable — which is indistinguishable from having no backup at all.
*.pem
*.crt
*.agekey
age.key
.tailscale/

# Financial data — never commit.
#
# These patterns are deliberately NOT root-anchored. A leading slash anchors to
# the repository root, so `/receipts/` missed `apps/api/receipts/` and
# `/backups/` missed `docker/backups/` — which are the paths the application
# actually writes to. This is a public Apache-2.0 repository whose README states
# it contains no financial data, so the patterns have to match where the files
# land rather than where someone imagined they would.
*.mmbak
*.sqlite
*.sqlite3
*.db
data/
receipts/
backups/
exports/
*.dump
*.sql.gz
# The nightly dump is age-encrypted before it leaves the Pi. Encrypted or not,
# a ledger snapshot is not a thing to have in a public repository.
*.age

# Bank statements and their conversions. The formats every bank exports, in any
# directory — this is how a statement arrives, and none of it belongs in git.
*.xls
*.xlsx
*.csv
*.ofx
*.qif
*.mt940
!docs/**/*.csv
!**/fixtures/**/*.csv

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# Editors and OS
.DS_Store
.idea/
*.swp
*.orig
*.rej
.vscode/*
# Shared on purpose: the formatter and the workspace TypeScript are project
# decisions, not personal ones. Everything else under .vscode/ stays local.
!.vscode/extensions.json
!.vscode/settings.json


# Expo build artifacts and generated types
apps/*/.expo/
apps/*/dist/
apps/*/ios/
apps/*/android/

# Local agent config. Every docs/agents/<name>.md is a committed default that
# works on a fresh clone; <name>.local.md is a personal override that stays on
# one machine. This is where a workflow that depends on tooling nobody else has
# — a private notes vault, a company tracker — goes, so the committed default
# never assumes it. tests/agent-docs.test.ts proves this pattern ignores.
docs/agents/*.local.md


# Working documents live in the Obsidian vault, never in the repo.
docs/superpowers/
CONTEXT.md

# BEGIN ai-rulez (DO NOT EDIT - managed by ai-rulez)
.ai-rulez/.generated-manifest.json
.claude/
.codex/
AGENTS.md
CLAUDE.md
# END ai-rulez
