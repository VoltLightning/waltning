{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // Internal packages export TypeScript source directly — tsx, Metro, and
    // Vite all transpile it. tsc is a typechecker here, not a build step, so
    // there is no dist/, no composite, and no stale-build failure mode.
    // Source-only packages import each other by real path, hence .ts specifiers.
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
