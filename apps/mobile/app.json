{
  "expo": {
    "name": "Waltning",
    "slug": "waltning",
    "scheme": "waltning",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.waltning.ios",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "app.waltning.android",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundColor": "#F4EBDD"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Waltning unlocks your ledger with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "voltlightnings-team",
    "extra": {
      "eas": {
        "projectId": "14d63e62-922d-4825-b240-4d0ce1f425b1"
      }
    }
  }
}
