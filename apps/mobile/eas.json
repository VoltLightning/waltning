{
  "cli": { "version": ">= 16.28.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ENABLE_PREVIEW_RESET": "true" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ENABLE_PREVIEW_RESET": "true" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "production": {
      "env": { "EXPO_PUBLIC_ENABLE_PREVIEW_RESET": "false" }
    }
  }
}
