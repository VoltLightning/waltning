{
  "name": "@waltning/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "bundle:all": "expo export --platform all",
    "bundle:android": "expo export --platform android",
    "bundle:ios": "expo export --platform ios",
    "bundle:web": "expo export --platform web",
    "dev": "expo start --go",
    "dev:android": "expo start --android --go",
    "dev:client": "expo start --dev-client",
    "dev:ios": "expo start --ios --go",
    "dev:web": "expo start --web",
    "preview:android": "EXPO_PUBLIC_ENABLE_PREVIEW_RESET=true expo run:android --variant release --device",
    "preview:ios": "EXPO_PUBLIC_ENABLE_PREVIEW_RESET=true expo run:ios --configuration Release --device",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-locale": "^5.3.10",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@logtape/logtape": "^2.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@trpc/client": "^11.18.0",
    "@waltning/client": "workspace:*",
    "@waltning/core": "workspace:*",
    "@waltning/ledger": "workspace:*",
    "@waltning/ui": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.15",
    "expo-crypto": "^57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@waltning/api": "workspace:*"
  }
}
