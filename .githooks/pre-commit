#!/bin/sh
#
# Pre-commit gate.
#
# architecture/07 records a deliberate decision: there is no CI — four
# packages, one developer. That makes this hook the *only* automated thing
# standing between an edit and history, which raises its importance rather
# than lowering it.
#
# It must therefore stay fast enough that it is never worth skipping.
# Budget is under two seconds: Biome over staged files (~0.3s) and a
# whole-program typecheck (~1.4s).
#
# Installed by the `prepare` script via `git config core.hooksPath .githooks`,
# so there is no hook-manager dependency to keep current.
#
# To bypass in a genuine emergency:  git commit --no-verify

set -eu

RED='\033[31m'
DIM='\033[2m'
OFF='\033[0m'

fail() {
  printf "\n${RED}✗ pre-commit: %s${OFF}\n" "$1" >&2
  [ $# -gt 1 ] && printf "${DIM}  %s${OFF}\n" "$2" >&2
  exit 1
}

# `D` is in the filter on purpose: a commit that only deletes files (`git rm`
# then commit) still needs Biome, typecheck, tests, and — if the deletion
# touches the visual trigger set — Playwright, because a deleted story or
# component changes what Storybook renders exactly as much as an edited one
# does. Dropping `D` here once meant a delete-only commit computed an empty
# `$staged` and skipped the entire hook (nothing below runs on `git diff
# --cached` again, only on this list) — that bug is gone with `D` in the
# filter, but nothing below may reintroduce it by short-circuiting on an
# empty `$staged` the way this used to.
#
# `--no-renames` is also load-bearing: without it a moved file can collapse
# to a single rename entry showing only the destination path, so a component
# moved *out of* `packages/ui/` (its old, visual-relevant path) would never
# appear in `$staged` at all. With `--no-renames` a move is a delete of the
# old path plus an add of the new one, on two separate lines, so whichever
# side matters — old or new — is always visible to every check below,
# `.githooks/needs-visual.sh` included.
staged=$(git diff --cached --name-only --diff-filter=ACMRD --no-renames)

# ── 1 · Anything force-added past .gitignore ─────────────────────────────────
#
# Ask git rather than re-implementing its rules. The list in the next block is
# a hand-written subset of .gitignore, and the two drifted the day they were
# written: `.env.production`, `data/x.db`, `exports/y.xlsx` and
# `apps/api/receipts/a.jpg` are all gitignored and all sailed past it.
#
# A staged file that .gitignore matches can only have got there through
# `git add -f`, which is exactly the case this hook exists for. Checking it
# this way inherits every present and future ignore rule and cannot drift.
forced=$(
  printf '%s\n' "$staged" | while IFS= read -r f; do
    # --no-index is load-bearing. `git check-ignore` consults the index, and a
    # force-added path is *tracked* — so ignore rules stop applying to it and
    # the check silently returns "not ignored" for precisely the files this
    # guard exists to catch. Without this flag the whole section is a no-op.
    if [ -n "$f" ] && git check-ignore -q --no-index -- "$f"; then printf '%s ' "$f"; fi
  done
)
if [ -n "$forced" ]; then
  fail "these are gitignored and were force-added:" "$forced"
fi

# ── 2 · Files that must never enter history, ignored or not ──────────────────
#
# The second layer, for shapes .gitignore does not cover.
#
# Scoped to paths that still exist (`--diff-filter=ACMR`, no `D`) — deleting
# a `.env` or a `.sqlite` file is cleanup, not the shape this guards against,
# and `$staged` includes deletions (H-2) precisely so the checks that *do*
# want to see them still can. A `present` computed the same way `$staged` is,
# minus `D`, is the fix rather than reusing `$staged` and filtering after:
# the two lists agreeing on order and de-duplication is not something to
# re-derive by hand in two places.
present=$(git diff --cached --name-only --diff-filter=ACMR --no-renames)

blocked=$(
  printf '%s\n' "$present" \
    | grep -Ei '(^|/)\.env$|\.(mmbak|sqlite|sqlite3|db|dump|age|xls|xlsx|ofx|qif|mt940|pem|crt|key|p8|p12|jks|keystore|mobileprovision)$' \
    | grep -vE '(^|/)\.env\.example$' \
    || true
)
if [ -n "$blocked" ]; then
  fail "these look like secrets or financial data:" "$(printf '%s' "$blocked" | tr '\n' ' ')"
fi

# CSV is a bank-statement format here, so it is blocked everywhere except the
# two places .gitignore already whitelists.
blocked_csv=$(
  printf '%s\n' "$present" \
    | grep -Ei '\.csv$' \
    | grep -vE '^docs/|/fixtures/' \
    || true
)
if [ -n "$blocked_csv" ]; then
  fail "CSV outside docs/ and fixtures/ is a bank statement:" "$(printf '%s' "$blocked_csv" | tr '\n' ' ')"
fi

# ── 3 · Key material by content ──────────────────────────────────────────────
#
# Catches a key pasted into an otherwise innocent file, which the path check
# above cannot see.
# This file is excluded from its own scan: the patterns below are written out
# literally here, so including it would make every edit to this hook look like
# a leaked key. The cost is that a secret pasted into the hook itself is not
# caught by the hook itself.
if git diff --cached -- . ':(exclude).githooks/pre-commit' \
  | grep -qE 'BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY|AGE-SECRET-KEY-1|sk-[A-Za-z0-9_-]{24,}|ghp_[A-Za-z0-9]{30,}|xox[baprs]-[A-Za-z0-9-]{20,}|PostgreSQL database dump'; then
  fail "the staged diff contains key material, a token, or a database dump."
fi

# ── 4 · Personal data sweep ──────────────────────────────────────────────────
#
# The repository is public and every real name, bank and balance was replaced
# with a placeholder. A bank name crept back in once while writing prose, which
# is what this exists to catch — the lesson was that the sweep has to run after
# every writing pass, and a lesson that depends on remembering is not a control.
#
# The term list itself cannot live in the repository, because it *is* the
# private data. Keep it at .githooks/private-terms.txt (gitignored); the vault
# note "Real to abstract mapping" is the source. One term per line, # for
# comments. Absent, this check is skipped with a notice rather than failing —
# a fresh clone by anyone else has nothing to sweep for.
terms=".githooks/private-terms.txt"
if [ -f "$terms" ]; then
  # Blank lines in a -f pattern file match every line, so they must go.
  cleaned=$(mktemp)
  trap 'rm -f "$cleaned"' EXIT
  grep -vE '^[[:space:]]*(#|$)' "$terms" > "$cleaned" || true
  if [ -s "$cleaned" ]; then
    # -w matches whole words only. Several terms on the list are short and sit
    # inside ordinary identifiers — one of them is a substring of a field name
    # this ledger uses — so substring matching refused perfectly clean code. A
    # guard that cries wolf gets bypassed, which is worse than not having it.
    hits=$(git diff --cached -- . | grep -inwFf "$cleaned" || true)
    if [ -n "$hits" ]; then
      fail "the staged diff contains a term from the private list." \
           "$(printf '%s' "$hits" | head -3 | cut -c1-100)"
    fi
  fi
else
  printf "${DIM}  pre-commit: no %s — personal-data sweep skipped${OFF}\n" "$terms"
fi

# ── 5 · The gate itself: format, types, tests, and — when it can move a pixel
#        — the visual suite ──────────────────────────────────────────────────
#
# One call to `pnpm verify` or `pnpm verify:fast`, never a second copy of what
# either already does. The Makefile earns the same rule from `tests/
# makefile.test.ts` — "Make orchestrates, pnpm implements" — for the same
# reason: two places that both know how to run a check is two places that go
# stale, and the one nobody is looking at is always the stale one. This hook
# used to run Biome, typecheck, and tests as three separate steps ahead of the
# visual decision; that was the second copy, quietly reimplementing
# `verify:fast` one command at a time.
#
# jsdom has no layout and no rendered colour, so `pnpm test` alone would pass
# a component that turned invisible. `pnpm verify`'s last step runs the built
# Storybook in a real browser and diffs it against committed baselines — the
# only check that can see a palette regression or a contrast failure axe
# cannot answer without pixels — which is also the only step worth skipping:
# a doc or migration commit cannot move a pixel, and paying several minutes
# for Playwright on one anyway would train people to reach for --no-verify.
#
# `.githooks/needs-visual.sh` is the one place the trigger set is written —
# read that file for the current list rather than this comment, which does
# not restate it on purpose: a second copy here is exactly the kind of
# duplication `.githooks/needs-visual.sh`'s own header exists to prevent, and
# `tests/verify-visual-gate.test.ts` fails loudly the day this hook's skip
# message below stops citing that file. Its exit code is the whole contract,
# and only one value means "skip":
#
#   1     not needed — run `pnpm verify:fast` (check, typecheck, test; no
#         Playwright).
#   else  needed (0), or undecidable (a bad regex, the script missing or
#         unreadable, anything) — run `pnpm verify` (the same, plus the
#         visual suite). An undecidable answer runs the suite; it never
#         skips it, because the alternative is a hook that goes quiet
#         exactly when something is wrong with the hook itself.
#
# This is also the whole decision `pnpm verify` needs: called bare, with no
# staged context, it always runs everything — there is no environment
# variable that reaches in and downgrades it. The hook is the only caller
# that ever runs `verify:fast`, and it only does so once it has looked.
#
# `set +e`/`set -e` around the pipe is load-bearing: under `set -eu` (line 19)
# a bare pipeline that exits 1 aborts the whole hook before `$?` can be read,
# and exit 1 is this script's normal, meaningful "skip" — not a failure.
set +e
printf '%s\n' "$staged" | sh .githooks/needs-visual.sh
decision=$?
set -e

remedy="pnpm fix (formatting), pnpm db:up (if a test cannot reach Postgres), pnpm --filter @waltning/ui build-storybook (if Storybook itself failed to build), or pnpm test:visual:update (if it was a screenshot diff)."

if [ "$decision" -eq 1 ]; then
  printf "${DIM}  pre-commit: nothing in the visual trigger set (see .githooks/needs-visual.sh) staged — running pnpm verify:fast (no Playwright)${OFF}\n"
  if ! pnpm verify:fast; then
    fail "verify:fast failed." "$remedy"
  fi
else
  if [ "$decision" -ne 0 ]; then
    printf "${DIM}  pre-commit: .githooks/needs-visual.sh exited %s (expected 0 or 1) — running the full suite to be safe${OFF}\n" "$decision"
  fi
  if ! pnpm verify; then
    fail "verify failed." "$remedy"
  fi
fi
