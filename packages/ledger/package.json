{
  "name": "@waltning/ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./accounts/*": "./src/accounts/*.ts",
    "./currencies/*": "./src/currencies/*.ts",
    "./transactions/*": "./src/transactions/*.ts",
    "./ddl": "./src/ddl.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./executor": "./src/executor.ts",
    "./migrate": "./src/migrate.ts",
    "./open": "./src/open.ts",
    "./outbox": "./src/outbox.ts",
    "./recover": "./src/recover.ts",
    "./registry": "./src/registry.ts",
    "./schema-map": "./src/schema-map.ts",
    "./session": "./src/session.ts",
    "./write": "./src/write.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config=drizzle.replica.config.ts --name=schema && drizzle-kit generate --config=drizzle.outbox.config.ts --name=schema && tsx tools/embed-ddl.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@waltning/core": "workspace:*",
    "@waltning/schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
