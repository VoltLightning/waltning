{
  "name": "@waltning/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./figures/signed.sql": "./src/figures/signed.sql.ts",
    "./rows": "./src/rows.ts",
    "./schema": "./src/schema.ts",
    "./test/scratch": "./src/test/scratch.ts"
  },
  "scripts": {
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed/run.ts",
    "fx": "tsx src/fx/backfill.ts",
    "recreate": "tsx src/reset.ts",
    "grant": "tsx src/reset.ts --grant-only",
    "fixture": "tsx src/seed/fixture.ts"
  },
  "dependencies": {
    "@waltning/core": "workspace:*",
    "@waltning/schema": "workspace:*",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
