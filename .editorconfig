# Universal editor baseline.
#
# biome.json is authoritative for JS/TS/JSON — it formats them and its explicit
# settings win over anything here. This file exists for everything Biome does
# not own: SQL migrations, YAML, Markdown and shell scripts, which are
# hand-written and still deserve consistent whitespace.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown. Stripping them would
# silently reflow the specification prose.
trim_trailing_whitespace = false
max_line_length = 80

[*.sql]
# Migrations are reviewed as SQL, not generated. They wrap wider than code.
max_line_length = 120

[Makefile]
indent_style = tab
