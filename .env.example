# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_USER=waltning
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waltning
POSTGRES_PORT=5442
DATABASE_URL=postgresql://waltning:change-me@127.0.0.1:5442/waltning

# --- Money Manager migration (Phase 0) ---
# Path to the latest .mmbak export and the mm-tools checkout that reads it.
MM_BACKUP=<path-to-exports>/<backup>.mmbak
MM_TOOLS_DIR=<path-to-mm-tools>

# --- Anthropic (Phase 3+: receipts, classification, agent) ---
ANTHROPIC_API_KEY=
