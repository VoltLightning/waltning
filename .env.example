# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Three database URLs, deliberately. §13.1's tax isolation is enforced by a
# Postgres role, and a superuser bypasses every GRANT — so the API must not use
# the bootstrap credential, and the export path must not use the API's.

# --- Database ---------------------------------------------------------------
#
# **The secrets below are empty on purpose.** compose guards them with
# `${VAR:?...}`, which fires on unset *or empty* and not on a placeholder — so
# a `change-me` here booted the entire appliance on a password published in a
# public repository, with every check reporting success. Empty is the only
# value that makes the guard you already have do its job.
#
# Generate one: `openssl rand -base64 24`
POSTGRES_USER=waltning                  # bootstrap SUPERUSER — migrations only
POSTGRES_PASSWORD=
POSTGRES_DB=waltning
POSTGRES_PORT=5442

# Migrations run as the superuser: 0003-0009 create triggers, views, roles and
# grants, which the app role does not have (and should not have) the rights for.
MIGRATE_DATABASE_URL=postgresql://waltning:@127.0.0.1:5442/waltning   # ← paste POSTGRES_PASSWORD after the colon

# The API. DML on everything, no DDL, NOT a superuser (§5.7).
APP_DATABASE_URL=postgresql://waltning_app:@127.0.0.1:5442/waltning   # ← paste POSTGRES_PASSWORD after the colon

# The same credential as APP_DATABASE_URL, addressed by service name instead of
# by loopback. Inside a container `127.0.0.1` is that container, so the compose
# stack cannot use the URL above — and pointing the container at the host would
# reach a *different* database on a machine that runs both.
APP_DATABASE_URL_CONTAINER=postgresql://waltning_app:@postgres:5432/waltning   # ← paste POSTGRES_PASSWORD after the colon

# The tax export path only. SELECT on tax_ledger and nothing else.
# createDb() takes this explicitly — a default argument would silently hand it
# the superuser and turn "fails loudly" into "succeeds quietly".
EXPORT_DATABASE_URL=postgresql://waltning_export:@127.0.0.1:5442/waltning   # ← paste POSTGRES_PASSWORD after the colon

# --- Auth (§5.2) ------------------------------------------------------------
# Generated on first boot and persisted to a mounted volume. Never hard-coded.
SESSION_SECRET=
TOTP_ISSUER=Waltning

# --- Network (§5.1) ---------------------------------------------------------
# Caddy serves the web bundle and proxies /trpc/* here. No public name exists.
TAILNET_HOSTNAME=waltning.<tailnet>.ts.net
BIND_ADDRESS=127.0.0.1                  # never 0.0.0.0 — the tailnet is the perimeter
API_PORT=3000
# Injected at image build time, reported by /healthz so a client can detect a
# stale bundle (architecture/05). Left unset in dev, where it reads "dev".
BUILD_SHA=

# --- Local development only -------------------------------------------------
# In production Caddy serves the web bundle and proxies /trpc on one host name,
# so the browser sees a single origin and CORS never applies. In dev, Metro
# serves the bundle on :8081 and the API answers on :3000 — two origins.
#
# LEAVE THIS UNSET ANYWHERE REAL. It is off unless set, refuses `*`, and refuses
# anything that is not loopback; the process will not start on a bad value.
# A simulator or phone sends no Origin at all and needs no entry here.
DEV_CORS_ORIGIN=

# Where the app looks for the API. Unset is correct for web (same origin in
# production, localhost:3000 in dev) and for the simulator, which shares this
# machine's loopback. A **real device** must have it — loopback on a phone is
# the phone — and it is how you point the app at a tailnet host:
#   EXPO_PUBLIC_API_URL=https://waltning.<tailnet>.ts.net
EXPO_PUBLIC_API_URL=

# The bundle's own build, so the client can tell it is older than the server
# (architecture/05, version skew). Injected by web.Dockerfile from the same
# `git rev-parse` the API image gets — set here only to point a dev bundle at a
# specific build for testing. Empty reads "dev", and skew is not reported in
# development, where both sides change independently by design.
#
# The example URL above used to be assigned to *this* variable, one line down
# from the comment that owned it. Copying the file unedited pointed the app at
# nothing and reported a git commit of "https://waltning.<tailnet>.ts.net" —
# and both halves failed quietly, because an empty API URL falls back to
# same-origin and a nonsense build only shows up as a skew banner that never
# fires.
EXPO_PUBLIC_BUILD_SHA=

# Where `pnpm e2e` looks. Both default to the local pair, so neither normally
# needs a value; they exist so the check can be pointed at the Pi over the
# tailnet without editing the script.
E2E_API_URL=
E2E_WEB_URL=

# --- The appliance (docker compose) -----------------------------------------
# Caddy's site address. The tailnet name on the Pi — that is what makes Caddy
# request and renew the Tailscale-issued certificate. Left at `:8080` (plain
# HTTP, loopback) for verifying the routing on a machine with no tailnet.
SITE_ADDRESS=
CADDY_PORT=8080

# --- Blobs (§10) ------------------------------------------------------------
# Receipt storage. `/readyz` contacts this and reports what it finds; leave
# MINIO_ENDPOINT empty and the probe omits the field rather than guessing, which
# is the right answer for a development stack that runs without it.
#
# The endpoint differs by caller, like the database URLs: `minio:9000` inside
# the compose network, `127.0.0.1:9000` from this machine.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=receipts
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backups (§5.4) ---------------------------------------------------------
# The age key is the real single point of failure — a bucket you cannot decrypt
# is indistinguishable from no backup. Public recipient here; the private key
# lives on a hardware token with a paper copy off-site.
AGE_RECIPIENT=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Model providers (§11.4) ------------------------------------------------
# One key per configured provider. Which model serves which surface is data, in
# the `models` table, edited on S33 — not configuration.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Observability (§15) ----------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production

# --- Money Manager migration (Phase 0 only) ---------------------------------
MM_BACKUP=<path-to-exports>/<backup>.mmbak
MM_TOOLS_DIR=<path-to-mm-tools>
